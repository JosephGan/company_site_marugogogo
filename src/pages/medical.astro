---
import Layout from "../layouts/BaseLayout.astro";
import MedicalContent from "../components/medical/MedicalContent.astro";

// Both languages are rendered at build time; global.css shows the pane matching <html lang>,
// which BaseLayout updates when the visitor switches language.
const langs = [
  { id: "zh", htmlLang: "zh-CN" },
  { id: "ja", htmlLang: "ja" },
] as const;
---

<Layout
  title="来日医疗服务"
  description="丸五株式会社来日医疗服务，涵盖大病医疗 Second Opinion、再生医疗、高端医疗美容与精密体检，以及阿部养庵堂 NMN 营养健康管理。"
>
  <section class="partners-section medical-service-page">
    {langs.map((lang) => (
      <div data-lang-pane={lang.id} lang={lang.htmlLang}>
        <MedicalContent lang={lang.id} />
      </div>
    ))}
  </section>
</Layout>

<script is:inline>
  (function () {
    // Activate a tab across both language panes so switching language keeps the same view.
    function activate(buttonAttr, panelAttr, value) {
      document.querySelectorAll("[" + buttonAttr + "]").forEach(function (button) {
        var on = button.getAttribute(buttonAttr) === value;
        button.classList.toggle("active", on);
        button.setAttribute("aria-selected", on ? "true" : "false");
      });
      document.querySelectorAll("[" + panelAttr + "]").forEach(function (panel) {
        panel.classList.toggle("active", panel.getAttribute(panelAttr) === value);
      });
    }

    document.addEventListener("click", function (event) {
      var tab = event.target.closest("[data-medical-tab]");
      if (tab) {
        activate("data-medical-tab", "data-medical-panel", tab.dataset.medicalTab);
        return;
      }
      var clinic = event.target.closest("[data-price-clinic]");
      if (clinic) {
        activate("data-price-clinic", "data-price-clinic-panel", clinic.dataset.priceClinic);
        return;
      }
      var series = event.target.closest("[data-product-series]");
      if (series) {
        activate("data-product-series", "data-product-series-panel", series.dataset.productSeries);
      }
    });

    // Allow deep links such as /medical#regenerative
    function openFromHash() {
      var hash = window.location.hash.slice(1);
      if (hash && document.querySelector('[data-medical-panel="' + hash + '"]')) {
        activate("data-medical-tab", "data-medical-panel", hash);
      }
    }
    openFromHash();
    window.addEventListener("hashchange", openFromHash);
  })();
</script>
